# Fleet HQ — SOVEREIGN BRAIN VAULT (template)
# ---------------------------------------------------------------------------
# Copy to `.env.local` (web/reception) and `mini-services/agent-hq/.env`
# (foreman), fill in real keys, then `chmod 600` both. These files are
# GITIGNORED — never commit real keys. This template IS committed so the
# office and development always know what brains the sovereign chain expects.
#
# The chain walks top→bottom and skips any brain that is cooling down
# (hard error → 5-minute per-brain+model cooldown). Keyless brains have no
# configuration at all — they are always available as the last free tier.

# 1) xAI Grok — crew + reception first brain (activates when credits exist)
XAI_API_KEY=
XAI_MODEL=grok-4-fast-non-reasoning
XAI_BASE_URL=https://api.x.ai/v1

# 2) OpenRouter — one key, a whole free pool (verified live 2025, free tier first)
OPENROUTER_API_KEY=
OPENROUTER_MODELS=nvidia/nemotron-3.5-lightning:free,nvidia/nemotron-3-super-120b-a12b:free,inclusionai/ling-3.0-flash-sante:free,cohere/north-mini-code:free,nvidia/nemotron-3-ultra-550b-a55b:free,deepseek/deepseek-chat-v3.1

# 3) Kilo Code free auto-router — KEYLESS by default (optional token raises limits)
KILO_API_KEY=
KILO_MODELS=kilo-auto/free

# 4) LLM7.io — anonymous tier is currently closed; a free token from token.llm7.io re-opens it
LLM7_API_KEY=
LLM7_MODELS=

# 5) Pollinations — KEYLESS (optional token for higher limits)
POLLINATIONS_TOKEN=
POLLINATIONS_MODELS=openai-fast

# 6) Any OpenAI-compatible endpoint (optional, between Pollinations and z-ai)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# 7) z-ai-web-dev-sdk — bundled deployments, no configuration needed
