# Sovereign LLM brain slots for Fleet HQ (foreman + reception share the same names).
# Copy to .env (foreman) and/or .env.local (Next.js reception) and fill what you have.
# NEVER commit the filled copies. Keyless brains work with everything empty.
#
# ---- 0. SOVEREIGN LOCAL GATEWAY (brain #0, zero-auth, default ON) -----------------
# The office's OWN OpenAI-compatible endpoint (mini-services/sovereign-gateway, :3011).
# Every consumer funnels through it: central rate-limit + cooldown management in ONE
# place. Set to 'off' to disable and rely on the direct chain below. Any string is a key.
SOVEREIGN_GATEWAY_URL=http://127.0.0.1:3011/v1
SOVEREIGN_GATEWAY_KEY=sovereign-local
# Sovereign network discipline (overall answer deadline ms / max brain+model attempts)
AI_TIMEOUT=60000
MAX_RETRIES=8
# Local reverse-engineered bridge (duckai — DuckDuckGo free AI backend, zero-auth).
# Source rescued in mini-services/duckai — run on a machine WITH DDG access, then set:
# DUCKAI_URL=http://127.0.0.1:3031/v1
# DUCKAI_MODELS=gpt-4o-mini,claude-3-5-haiku-latest,gpt-5-mini,mistralai/Mistral-Small-24B-Instruct-2501
#
# 1. xAI Grok — https://console.x.ai
XAI_API_KEY=
XAI_MODEL=grok-4-fast-non-reasoning
XAI_BASE_URL=https://api.x.ai/v1
#
# 2. OpenRouter — https://openrouter.ai/keys (1 strong model + :free rotation)
OPENROUTER_API_KEY=
OPENROUTER_MODELS=deepseek/deepseek-chat-v3.1,nvidia/nemotron-3.5-lightning:free,inclusionai/ling-3.0-flash-sante:free,google/gemma-4-26b-a4b-it:free,thinkingmachines/inkling:free,cohere/north-mini-code:free,nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3-ultra-550b-a55b:free,poolside/laguna-s-2.1:free
#
# 3. Kilo Code gateway — keyless anonymous works; optional free key raises limits
KILO_API_KEY=
KILO_MODELS=kilo-auto/free
#
# 4. LLM7.io — anonymous tier is quota-drained daily; a free token from token.llm7.io fixes it
LLM7_API_KEY=
LLM7_MODELS=mistral-Nemo-Instruct-2407
#
# 5. Pollinations — keyless anonymous works; optional tier token
POLLINATIONS_TOKEN=
POLLINATIONS_MODELS=openai-fast
#
# 6. OVHcloud AI Endpoints — EU anonymous tier works; optional key lifts it
OVH_API_KEY=
OVH_MODELS=gpt-oss-120b,Meta-Llama-3_3-70B-Instruct
#
# 7. Any OpenAI-compatible brain (last keyed fallback)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# ---- free-tier keyed brains (auto-activate the moment a key is pasted) ----
# Get free keys in minutes: groq.com/keys · cloud.cerebras.ai · console.mistral.ai
# aistudio.google.com · github.com/settings/models · api.together.xyz
GROQ_API_KEY=
GROQ_MODELS=
CEREBRAS_API_KEY=
CEREBRAS_MODELS=
MISTRAL_API_KEY=
MISTRAL_MODELS=
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODELS=
GITHUB_MODELS_TOKEN=
GITHUB_MODELS=
TOGETHER_API_KEY=
TOGETHER_MODELS=
# cross-process front-desk priority flag (ephemeral; default /tmp/fleethq-reception-priority)
RECEPTION_PRIORITY_FILE=
