# ---- foreman (optional) -------------------------------------------------
# where your real JSON "books" live (default: foreman/data/)
# AGENT_HQ_DATA_DIR=/path/to/your/books

# force the clearly-labeled demo crew regardless of LLM availability
# AGENT_HQ_MODE=sim

# socket port for the foreman (web expects 3010 via your proxy)
# AGENT_HQ_PORT=3010

# ---- LLM provider (optional; needed only for LIVE mode) -----------------
# any OpenAI-compatible endpoint:
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# if z-ai-web-dev-sdk is installed next to the foreman it is used automatically
