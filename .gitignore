# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/
# secrets — never in git
/upload/
*.rar

# FleetHQ sovereign hygiene — session junk, runtime data, embedded repos
/tool-results/
/.tmp-tools/
/db/
/fleethq/
/Domain/
/Console/
/v*-*.png
/.env

# FleetHQ origin patterns (union)
foreman/data/
vault/keys.env
vault/.passphrase
*.zip
mini-services/agent-hq/data
*.pid
/.backups/

# ── sovereign vault: plaintext secrets NEVER travel ──────────────────────────
# plaintext SSH deploy keys (only their SEALED tar ships: vault/ssh-keys.tar.enc)
vault/ssh/
vault/.ssh-installed
# unwrapped master passphrase (session-only, 600, never committed)
vault/.session-pass
# wrap registry lives ONLY in the private fleet-vault repo (never public)
vault/wraps/
# agent-facing LLM block (generated by boot-sovereign.sh)
sovereign-agent.env
# private vault repo working copy
.vault-private-repo/

# ── air-gap kit: machine-local artifacts never travel ────────────────────────
# 1.9GB model binaries, per-host probe results and tuned env stay local
mini-services/sovereign-gateway/airgap/models/
mini-services/sovereign-gateway/airgap/host-capabilities.json
mini-services/sovereign-gateway/airgap/llama-host.env
mini-services/sovereign-gateway/airgap/download.log
mini-services/sovereign-gateway/airgap/download-status.txt
# .env.example files are documentation — they MUST ship (secrets never do)
!**/.env.example

# ── receipts: telemetry-latest churns every 30s (history/events/lineage ship) ──
receipts/gateway-telemetry-latest.json
receipts/*.tmp-*

# ── broadcast: staging buffer is runtime churn (README ships the law) ──
broadcast/staging/
.shots/
