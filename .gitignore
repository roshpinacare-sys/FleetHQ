# ─────────────────────────────────────────────────────────────
# FleetHQ .gitignore — P0 remediation
# Principle: code is truth. Agent runtime emissions, build
# artifacts and local state NEVER travel in git.
# ─────────────────────────────────────────────────────────────

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js / builds
/.next/
/out/
/build
dist/
dist-office3d/

# testing
/coverage

# env & secrets — never track
.env*
!.env.example
*.pem
upload/
vault/keys.env
vault/.passphrase
vault/ssh/
vault/.ssh-installed
vault/.session-pass
vault/wraps/
sovereign-agent.env
.vault-private-repo/
*.secret

# logs & debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
daemon.out
*.pid

# OS / editor junk
.DS_Store
Thumbs.db
*.rar
*.zip

# python artifacts
__pycache__/
*.pyc

# typescript
*.tsbuildinfo
next-env.d.ts
local-*
# local-brain / local-beats are sovereign organs — they travel with the repo
!mini-services/local-brain/
!mini-services/local-beats/

# ── agent runtime emissions (code is truth; state stays host-local) ──
# office/state/*.json is the PUBLISHED UI data plane (read from origin by
# /api/visitor-chat, /api/worlds-state, office-window publishers) — tracked
# by design, NOT an emission. Everything else below stays host-local.
tmp/
tool-results/
# receipts/ is host-local — EXCEPT three lanes whose consumers read them
# back from origin git: CI verdicts (office-ci, office-3d) and the foreman's
# durable task mirror (wipe-recovery + the office-3d bake anchor).
receipts/*
!receipts/office-ci/
!receipts/office-3d/
!receipts/office-state-mirror.json
ops/
pacemaker/
t19b/
t24/agentcraft/
broadcast/staging/
.shots/
.probe/
.roster-map.local.json
sovereign-stack/receipts/
mini-services/micro-work-rig/state/
mini-services/micro-work-rig/rig.out
mini-services/micro-work-rig/*.log
mini-services/agent-hq/Domain/
mini-services/agent-hq/data/
foreman/data/
mini-services/sovereign-gateway/airgap/models/
mini-services/sovereign-gateway/airgap/host-capabilities.json
mini-services/sovereign-gateway/airgap/llama-host.env
mini-services/sovereign-gateway/airgap/download.log
mini-services/sovereign-gateway/airgap/download-status.txt
public/office-state.json

# local scaffolding / nested clones that must never return
.claude
.z-ai-config
/skills/
/.backups/
/.tmp-tools/
/db/
/fleethq/
/Domain/
/Console/
/v*-*.png

# health-guard runtime events stay host-local
mini-services/health-guard/state/
