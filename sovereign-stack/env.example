# Sovereign Stack — environment (copy to .env; autonomy owns these values)
# Ownership law: real values come from the office vault (FleetHQ/office),
# NEVER from the operator. This file is the fallback shape.

# Inference layer (used by the docker compose)
LOCAL_MODEL_FILE=qwen2.5-coder-7b-q4_k_m.gguf
LOCAL_CTX=8192
LOCAL_GPU_LAYERS=0
LLM7_API_KEY=unused

# Langfuse self-hosted secrets (generate: python3 -c "import secrets;print(secrets.token_urlsafe(32))")
LF_PG_PASSWORD=change-me-strong
LF_NEXTAUTH_SECRET=change-me-strong
LF_SALT=change-me-strong
LF_ENCRYPTION_KEY=change-me-strong
LITELLM_MASTER_KEY=sk-sovereign-change-me

# Router defaults (sovereign_router.py) — verified live 2026-10-08
OPENAI_API_BASE=http://localhost:4000/v1
OPENAI_API_KEY=sk-sovereign-change-me
MODEL_NAME=local-primary
FREE_LANE_MODEL=GLM-5.3-Flash
REQUEST_TIMEOUT=90
MAX_NETWORK_RETRIES=8
AUTO_RECONNECT=true

# Runtime law: local isolated execution — no cloud sandboxes needing operator keys
SOVEREIGN_RUNTIME=local
# SOVEREIGN_OFFICE_ENV=/path/to/FleetHQ/office/keys.env   # vault-loaded routes

# Task 33: alternate posting-account witness lane (health_monitor.py).
# PUBLIC ADDRESSES ONLY (0x + 20 bytes). Prefer the local 0600 file
# credentials/witness-accounts.json (gitignored) over this env var.
# Shape: [{"label":"alt-a","address":"0x...","via":["eth-mainnet-rpc"]}]
# "via" empty → every POST target tagged chain=eth is used.
# FLEET_WITNESS_ACCOUNTS=[{"label":"alt-a","address":"0x0000000000000000000000000000000000000000"}]
