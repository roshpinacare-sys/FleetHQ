{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/roshpinacare-sys/FleetHQ/sovereign/stack/identity/registration.schema.json",
  "title": "SAOS agent registration (ERC-8004 registration-v1 shape + estate extensions)",
  "type": "object",
  "required": ["type", "name", "description", "services", "active"],
  "properties": {
    "type": { "const": "https://eips.ethereum.org/EIPS/eip-8004#registration-v1" },
    "name": { "type": "string", "minLength": 1, "maxLength": 64 },
    "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "image": { "type": "string" },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "endpoint"],
        "properties": {
          "name": { "type": "string" },
          "endpoint": { "type": "string", "minLength": 1 },
          "version": { "type": "string" }
        }
      }
    },
    "x402Support": { "type": "boolean" },
    "active": { "type": "boolean" },
    "agentRegistry": {
      "type": "string",
      "description": "ERC-8004 global id {namespace}:{chainId}:{identityRegistry}; pre-mint form uses the literal 'staged-deployment' registry address"
    },
    "preMintAgentId": { "type": "string", "pattern": "^0x[0-9a-f]{40}$" },
    "deploymentStatus": { "enum": ["staged", "minted", "retired"] },
    "capabilities": {
      "type": "array",
      "items": { "type": "string" },
      "description": "estate-scoped capability tokens (e.g. capital-sweep, measurement, self-heal)"
    },
    "policyRef": {
      "type": "string",
      "description": "Layer-2 link: path to the policy rulebook that governs this agent"
    },
    "runtimeRef": {
      "type": "string",
      "description": "Layer-3 link: path to the runtime skill/entrypoint this agent executes"
    },
    "ownerOfRecord": { "type": "string", "const": "roshpinacare-sys" },
    "trustAnchors": {
      "type": "array",
      "items": { "type": "string" },
      "description": "evidence anchors: run URLs, tx hashes, receipts proving this agent is live"
    }
  },
  "additionalProperties": false
}
